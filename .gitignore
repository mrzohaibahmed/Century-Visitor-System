# Secrets & local configuration — never commit
.env
.env.*
!.env.example

# Production secrets and key material (deploy/): never commit, even by accident
secrets/
*.pem
*.key
*.keyfile
*.pfx
*.uri.txt

# Local database, photos, logs and operational runtime state
.cgvms/
# Ignore obsolete layouts too, so an old script cannot accidentally add generated data.
.dev/
.prod/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# OS / editors
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
