# Secrets & local configuration — never commit
.env
.env.*
!.env.example

# Production secrets and key material (deploy/): never commit, even by accident
secrets/
*.pem
*.key
*.keyfile
*.pfx
*.uri.txt

# Local development database, logs, scratch
.dev/
# start-production.bat runtime files: logs, status (and leftovers of the former Caddy setup)
.prod/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# OS / editors
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
