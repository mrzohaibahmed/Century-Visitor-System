# Copy to backend/.env for local development. Never commit the real .env.
# In production these come from the server's environment / secret files.

CG_ENVIRONMENT=development

# The NEW web database. Never the legacy desktop database (century_gate_system):
# the API refuses to start with that name.
CG_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=cgvms-dev
CG_MONGO_DB=century_gate_vms
CG_MONGO_TIMEOUT_MS=5000

# SQL Server (replacing MongoDB step by step). Set up / update the database with:
#   python -m app.db.sql create-database   then   python -m app.db.sql migrate   (check: python -m app.db.sql check)
CG_MSSQL_SERVER=.\SQLEXPRESS
CG_MSSQL_DATABASE=century_gate_vms
# CG_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Empty username = Windows authentication (the account running the API). A SQL login needs both:
# CG_MSSQL_USERNAME=cgvms_app
# CG_MSSQL_PASSWORD=
# The connection is always encrypted. An instance on THIS PC has a self-signed certificate by default,
# so skip the certificate check for it (refused for a server on the network):
CG_MSSQL_TRUST_SERVER_CERTIFICATE=true
# CG_MSSQL_TIMEOUT_SECONDS=5

CG_LOG_LEVEL=INFO
CG_TIMEZONE=Asia/Karachi

# Interactive docs at /api/docs (default: on in development only)
# CG_API_DOCS=true

# Visitor photos: a PRIVATE folder on the API server (not under frontend/).
# Required in production. Development default: ..\.cgvms\data\photos
# CG_PHOTO_DIR=D:\CenturyGateVMS\photos
# CG_PHOTO_MAX_BYTES=2097152

# Visitor passes: the QR on a badge stops working at check-out, when reissued, or at this local clock
# time (CG_TIMEZONE), e.g. 16:30 = same day until 4:30 pm.
# CG_PASS_DAY_END_HOUR=16
# CG_PASS_DAY_END_MINUTE=30
# How often (seconds) to look for overstays and e-mail the host and department.
# CG_OVERSTAY_POLL_SECONDS=60
# Printed at the top of visitor badges.
# CG_ORGANIZATION_NAME=Century Paper & Board Mills

# E-mail to hosts when their visitor arrives (Phase 6A). Empty CG_SMTP_HOST = e-mail off
# (the default in development; the in-app bell still works). SMTP settings saved by an administrator
# (API /api/v1/settings/email) take precedence over these; these apply when none are saved.
# CG_SMTP_HOST=smtp.example.com
# CG_SMTP_PORT=587
# CG_SMTP_SECURITY=starttls
# CG_SMTP_USERNAME=
# CG_SMTP_PASSWORD=
# CG_SMTP_FROM=Century Gate VMS <vms@example.com>

# Key for database secrets (camera passwords and matching badge QR print data), AES-256-GCM.
# Generate with: python -m app.cli generate-secrets-key   (never commit it or change it without a recovery plan)
# Without it, guards must scan the physical badge to print its QR on a belongings slip.
# CG_SECRETS_KEY=

# First-run account: "python -m app.cli first-admin" (run by start-dev.bat / production.ps1) creates
# the user "admin" with this temporary password, only when the database has no accounts yet.
# It must be changed at the first login. Empty or unset: admin1234.
CG_FIRST_ADMIN_PASSWORD=admin1234
