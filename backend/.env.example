# Copy to backend/.env for local development. Never commit the real .env.
# In production these come from the server's environment / secret files.

CG_ENVIRONMENT=development

# The NEW web database. Never the legacy desktop database (century_gate_system):
# the API refuses to start with that name.
CG_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=cgvms-dev
CG_MONGO_DB=century_gate_vms
CG_MONGO_TIMEOUT_MS=5000

CG_LOG_LEVEL=INFO
CG_TIMEZONE=Asia/Karachi

# Interactive docs at /api/docs (default: on in development only)
# CG_API_DOCS=true

# Visitor photos: a PRIVATE folder on the API server (not under frontend/), included in backups.
# Required in production. Development default: ..\.dev\photos
# CG_PHOTO_DIR=D:\CenturyGateVMS\photos
# CG_PHOTO_MAX_BYTES=2097152

# Visitor passes: the QR on a badge stops working at check-out, when reissued, or after this many hours.
# CG_PASS_VALID_HOURS=24
# Printed at the top of visitor badges.
# CG_ORGANIZATION_NAME=Century Gate
