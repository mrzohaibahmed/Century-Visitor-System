<!--
  Century Gate VMS - HTTPS entry point (Caddy), Windows service "CGVMS-Proxy".
  The only service reachable from the network (ports 443, and 80 which only redirects to HTTPS).
  install-services.ps1 fills in __APP_DIR__, __SITE__ and __TLS_MODE__ from cgvms.psd1
  (AppDir, SiteName, TlsMode); edit those there, not here.
-->
<service>
  <id>CGVMS-Proxy</id>
  <name>Century Gate VMS - HTTPS proxy</name>
  <description>Century Gate visitor management: HTTPS for the gate PCs (Caddy), forwarding to CGVMS-Web and CGVMS-API.</description>
  <executable>%BASE%\..\tools\caddy.exe</executable>
  <arguments>run --config "__APP_DIR__\deploy\windows\caddy\Caddyfile"</arguments>
  <workingdirectory>__APP_DIR__\deploy\windows\caddy</workingdirectory>
  <env name="CGVMS_SITE" value="__SITE__"/>
  <env name="CGVMS_TLS_MODE" value="__TLS_MODE__"/>
  <env name="CGVMS_TLS_CERT" value="%BASE%\..\tls\web\cert.pem"/>
  <env name="CGVMS_TLS_KEY" value="%BASE%\..\tls\web\key.pem"/>
  <env name="CGVMS_CADDY_DATA" value="%BASE%\..\caddy-data"/>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="2 min"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%BASE%\..\logs\proxy</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
