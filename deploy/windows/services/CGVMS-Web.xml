<!--
  Century Gate VMS - web frontend (Next.js production server), Windows service "CGVMS-Web".
  Runs the production build (npm run build) with "next start", never the development server.
  No secrets: API_INTERNAL_URL is where Next.js reaches the API on this server.
-->
<service>
  <id>CGVMS-Web</id>
  <name>Century Gate VMS - Web</name>
  <description>Century Gate visitor management: Next.js frontend on 127.0.0.1:3000 (reached only through CGVMS-Proxy).</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>node_modules\next\dist\bin\next start --hostname 127.0.0.1 --port 3000</arguments>
  <workingdirectory>__APP_DIR__\frontend</workingdirectory>
  <env name="NODE_ENV" value="production"/>
  <env name="API_INTERNAL_URL" value="http://127.0.0.1:8000"/>
  <env name="NEXT_TELEMETRY_DISABLED" value="1"/>
  <depend>CGVMS-API</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="2 min"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>%BASE%\..\logs\web</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
