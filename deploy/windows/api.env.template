# Century Gate VMS API - PRODUCTION settings.
# Copy to C:\CenturyGateVMS\app\api\.env on the server, fill in the values, and restrict it
# (install-services.ps1 makes it readable only by Administrators, SYSTEM and the CGVMS-API service).
# Never commit the real file, never e-mail it, never copy it to a gate PC.

CG_ENVIRONMENT=production

# Paste the ONE line from C:\CenturyGateVMS\secrets\cgvms_app.uri.txt (written by cgvms_mongo.py init):
# the application's own database account (read/write on century_gate_vms only), TLS with the
# database CA. The API refuses to start without a user/password, without TLS, or with any option
# that switches certificate checks off.
CG_MONGO_URI=PASTE-FROM-secrets\cgvms_app.uri.txt
CG_MONGO_DB=century_gate_vms

# Private photo folder: must exist before the API starts (it refuses to start otherwise),
# writable by the CGVMS-API service, NOT under app\web, and included in backups.
CG_PHOTO_DIR=D:\CenturyGateVMS-Photos

# Printed at the top of every visitor badge.
CG_ORGANIZATION_NAME=Century Gate

CG_LOG_LEVEL=INFO
CG_TIMEZONE=Asia/Karachi

# Sessions: idle logout of a gate PC and the absolute limit (one shift).
CG_SESSION_IDLE_MINUTES=15
CG_SESSION_MAX_HOURS=12
# Must stay true: session cookies are HTTPS-only (the API refuses false in production).
CG_COOKIE_SECURE=true

# Only the local reverse proxy (Caddy) may report client addresses (X-Forwarded-For).
CG_TRUSTED_PROXIES=["127.0.0.1","::1"]

# Visitor passes (QR on the badge) stop working after this many hours at the latest.
CG_PASS_VALID_HOURS=24

# Interactive API documentation stays OFF in production (leave unset).
# CG_API_DOCS=false
